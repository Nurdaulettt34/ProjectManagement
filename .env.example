# Copy to .env and fill in. Never commit .env.

# development | testing | production
APP_ENV=development

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL 16. Without Docker the host is localhost
# (docker compose overrides these two with host "postgres").
DATABASE_URL=postgresql+psycopg://uniflow:uniflow@localhost:5432/uniflow
TEST_DATABASE_URL=postgresql+psycopg://uniflow:uniflow@localhost:5432/uniflow_test

# Seed accounts (flask seed). Passwords are required in production.
SEED_STAFF_EMAIL=staff@uniflow.edu
SEED_STAFF_PASSWORD=
SEED_ADMIN_EMAIL=admin@uniflow.edu
SEED_ADMIN_PASSWORD=

# Optional LLM provider. Empty key = rule-based AI (offline, deterministic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CONFIDENCE_THRESHOLD=0.5

# Students may register only with this university domain (name@sdu.edu.kz, name@stu.sdu.edu.kz).
# Applicants can use any email.
STUDENT_EMAIL_DOMAIN=sdu.edu.kz

# Email with the 6-digit confirmation code.
# Leave MAIL_SERVER empty for local development: the email (with the code) is printed
# to the server log -> `docker compose logs -f web`.
# Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=your@gmail.com,
#        MAIL_PASSWORD=<16-character App Password> (needs 2-Step Verification).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=
# smtp | console. Default: smtp if MAIL_SERVER is set, else console (production: always smtp).
MAIL_BACKEND=
